+static std::string EnvString(const char* name) {
+    const char* value = std::getenv(name);
+    return value ? std::string(value) : std::string();
+}
+
+static bool Socks5Authenticate(SOCKET s) {
+    const std::string username = EnvString("SPLITPROXY_SOCKS_USERNAME");
+    const std::string password = EnvString("SPLITPROXY_SOCKS_PASSWORD");
+    const bool use_auth = !username.empty() || !password.empty();
+
+    if (use_auth && (username.empty() || password.empty() || username.size() > 255 || password.size() > 255)) {
+        std::cerr << "[socks5] Invalid username/password configuration\n";
+        return false;
+    }
+
+    uint8_t hello[3] = { 0x05, 0x01, static_cast<uint8_t>(use_auth ? 0x02 : 0x00) };
+    if (!SendAll(s, hello, 3)) return false;
+
+    uint8_t response[2];
+    if (!RecvAll(s, response, 2) || response[0] != 0x05) return false;
+
+    if (response[1] == 0x00)
+        return !use_auth;
+
+    if (response[1] != 0x02 || !use_auth)
+        return false;
+
+    std::vector<uint8_t> auth;
+    auth.reserve(3 + username.size() + password.size());
+    auth.push_back(0x01);
+    auth.push_back(static_cast<uint8_t>(username.size()));
+    auth.insert(auth.end(), username.begin(), username.end());
+    auth.push_back(static_cast<uint8_t>(password.size()));
+    auth.insert(auth.end(), password.begin(), password.end());
+
+    if (!SendAll(s, auth.data(), static_cast<int>(auth.size()))) return false;
+
+    uint8_t auth_response[2];
+    return RecvAll(s, auth_response, 2) && auth_response[0] == 0x01 && auth_response[1] == 0x00;
+}
